const CONFIG_PATH = '/etc/panel-backup/config.json';
const STATE_DIR = '/var/lib/panel-backup'; // job records + logs (small text, on the SSD), group-readable by the panel
const JOBS_DIR = path.join(STATE_DIR, 'jobs');
const LOGS_DIR = path.join(STATE_DIR, 'logs');
