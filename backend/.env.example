# Port the panel listens on (Cloudflare route: http://localhost:4000)
PORT=4000
# Keep 127.0.0.1 so the panel is only reachable through Cloudflare Tunnel
HOST=127.0.0.1
# How often to read CPU/RAM/disk (milliseconds)
SAMPLE_MS=5000
# How much history to keep in memory
HISTORY_MINUTES=60
# Secret that your apps send with request counts. Generate one with: openssl rand -hex 24
INGEST_TOKEN=

# ---------- Login / multi-user ----------
# Required. Signs login sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# How long a login lasts (hours)
SESSION_HOURS=12
# Cookies are Secure (HTTPS only). Set to false ONLY for local development over plain http
COOKIE_SECURE=true
# Where users, sessions and the audit log are stored (default: backend/data/panel.db)
# DB_PATH=
# LXD REST API socket (the "kapil" user must be in the "lxd" group)
LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
# SSH hostname shown on each container card; {name} becomes the container name
SSH_HOST_TEMPLATE={name}.gyannportal.com

# ---------- Backups ----------
# Root helper the panel runs through sudo, and where the helper writes job records + logs.
# Only change these if you installed them somewhere else.
# BACKUP_HELPER=/usr/local/sbin/panel-backup
# BACKUP_STATE_DIR=/var/lib/panel-backup

# ---------- Kapil Cloud ----------
# Key for encrypting app env vars / git tokens at rest (64 hex chars: openssl rand -hex 32).
# If unset, a key is derived from SESSION_SECRET (then rotating SESSION_SECRET makes saved app secrets unreadable).
SECRETS_KEY=
# systemd units shown on Monitoring -> Services (alerts if one is installed but failed/inactive)
# MONITOR_SERVICES=snap.lxd.daemon,cloudflared,nginx,ssh,panel-backup.timer
# Check the backup disk (mount, free space, SMART) every 10 minutes through the backup helper. "off" to disable.
# BACKUP_DISK_CHECK=on

# Cloudflare Tunnel automation for user domains (optional). Without these, approved domains show the route to add by hand.
# Token permissions: Account > Cloudflare Tunnel > Edit, and Zone > DNS > Edit for your zone(s).
# CF_ACCOUNT_ID is 32 hex chars (in the dashboard URL); CF_TUNNEL_ID is the tunnel UUID (cloudflared tunnel list).
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_TUNNEL_ID=

# ---------- Host services: PM2 / Docker / replicas + Nginx load balancer (docs/HOST_APPS.md) ----------
# Folders the panel may start PM2 apps / build Docker images from (comma list; default: the panel user's home).
# HOST_APP_ROOTS=/home/kapil/apps
# Programs (argv, no shell). Defaults shown.
# PM2_BIN=pm2
# DOCKER_BIN=docker
# DOCKER_SOCKET=/var/run/docker.sock        # panel user must be in the "docker" group (root-equivalent, like "lxd")
# NGINX_TEST=sudo -n /usr/sbin/nginx -t     # allowed by system/install-lb.sh
# NGINX_RELOAD=sudo -n /usr/bin/systemctl reload nginx
# Where the panel writes load balancer sites and where Nginx writes their access logs
# LB_CONF_DIR=/etc/nginx/kapil-cloud
# LB_LOG_DIR=/var/log/nginx/kapil-cloud
# Local Nginx stub_status port (active connections). Must be free.
# LB_STATUS_PORT=18089
# Port ranges for replicas (each instance gets one) and for load balancer listeners (127.0.0.1 only)
# REPLICA_PORTS=5000-5999
# LB_PORTS=8100-8199
# Health checks: interval, and how long a (re)started instance may take to become healthy
# HEALTH_INTERVAL_MS=10000
# HEALTH_WAIT_MS=60000

# ---------- Databases, Security center (docs/PLATFORM.md) ----------
# Ports for databases created on the Databases page (127.0.0.1 / LXD bridge only)
# DB_PORTS=15400-15999
# Root helper for firewall / fail2ban / security check (installed by system/install-security.sh)
# SECURITY_HELPER=/usr/local/sbin/kapil-security
