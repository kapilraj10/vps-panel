# Port the panel listens on (Cloudflare route: http://localhost:4000)
PORT=4000
# Keep 127.0.0.1 so the panel is only reachable through Cloudflare Tunnel
HOST=127.0.0.1
# How often to read CPU/RAM/disk (milliseconds)
SAMPLE_MS=5000
# How much history to keep in memory
HISTORY_MINUTES=60
# Secret that your apps send with request counts. Generate one with: openssl rand -hex 24
INGEST_TOKEN=

# ---------- Login / multi-user ----------
# Required. Signs login sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=
# How long a login lasts (hours)
SESSION_HOURS=12
# Cookies are Secure (HTTPS only). Set to false ONLY for local development over plain http
COOKIE_SECURE=true
# Where users, sessions and the audit log are stored (default: backend/data/panel.db)
# DB_PATH=
# LXD REST API socket (the "kapil" user must be in the "lxd" group)
LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
# SSH hostname shown on each container card; {name} becomes the container name
SSH_HOST_TEMPLATE={name}.gyannportal.com

# ---------- Backups ----------
# Root helper the panel runs through sudo, and where the helper writes job records + logs.
# Only change these if you installed them somewhere else.
# BACKUP_HELPER=/usr/local/sbin/panel-backup
# BACKUP_STATE_DIR=/var/lib/panel-backup
