const SPACE_MARGIN = 0.9; // estimated size must fit in 90% of the free space
const MiB = 1024 ** 2;
const GiB = 1024 ** 3;
const LS_MAX = 5000;

const ID_RE = /^\d{8}-\d{6}$/;
// Must not start with a dash, so a name can never be read as an option by lxc
const CT_RE = /^[a-z0-9][a-z0-9-]{0,62}$/;
// LXD rules for a new instance name: starts with a letter, no trailing dash
const NEW_CT_RE = /^[a-z][a-z0-9-]{0,61}[a-z0-9]$/;
const USER_RE = /^[a-z_][a-z0-9_-]{0,31}$/;
const DB_FILE_RE = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,200}\.(?:sql|archive)\.gz$/;
const DOCKER_NAME_RE = /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/;
const TIME_RE = /^([01]\d|2[0-3]):[0-5]\d$/;
const TZ_RE = /^[A-Za-z]+(?:\/[A-Za-z0-9_+-]+){0,2}$/;
const HOST_PATH_RE = /^\/[A-Za-z0-9._@+/ -]*$/;
const PROGRESS_RE = /^\s*[\d,.]+\w*\s+(\d{1,3})%\s/;
const TARGETS = ['containers', 'host', 'databases', 'pm2'];
const ORDER = ['pm2', 'databases', 'containers', 'host']; // quick ones first, rsync last

